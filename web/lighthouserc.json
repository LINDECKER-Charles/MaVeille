{
  "ci": {
    "collect": {
      "staticDistDir": "dist/veille/browser",
      "url": [
        "http://localhost/index.html",
        "http://localhost/fil/index.html",
        "http://localhost/jours/index.html",
        "http://localhost/stats/index.html",
        "http://localhost/rapports/index.html",
        "http://localhost/digest/2026-06-20/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
