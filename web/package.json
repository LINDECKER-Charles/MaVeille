{
  "name": "veille",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate": "node tools/build-data.mjs",
    "prebuild": "node tools/build-data.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node tools/build-data.mjs",
    "test": "ng test --no-watch --code-coverage --browsers=ChromeHeadless",
    "test:generator": "node --test tools/build-data.test.mjs",
    "lint": "ng lint",
    "pree2e": "npm run build",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.29",
    "mermaid": "^11.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.29",
    "@angular/cli": "^20.3.29",
    "@angular/compiler-cli": "^20.3.0",
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0",
    "@types/jasmine": "~5.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.19",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.18.0",
    "http-server": "^14.1.1",
    "isomorphic-dompurify": "^2.36.0",
    "jasmine-core": "~5.9.0",
    "js-yaml": "^4.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "marked": "^14.1.4",
    "shiki": "^3.23.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0"
  }
}
