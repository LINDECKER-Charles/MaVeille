{
  "_comment": "Lexique de prononciation FR pour la synthèse vocale. Ordre IMPORTANT : les regex spécifiques (CVE, versions) AVANT les génériques (sigles). Appliqué après le nettoyage inline, avant la segmentation. Syntaxe de remplacement : $1, $2… pour les groupes capturés. Extensible librement.",
  "rules": [
    { "pattern": "\\bCVE-(\\d{4})-(\\d+)",                 "replace": "C-V-E $1 $2" },
    { "pattern": "\\bCVE\\b",                              "replace": "C-V-E" },
    { "pattern": "\\bCVSS\\b",                             "replace": "C-V-S-S" },
    { "pattern": "\\bv?(\\d+)\\.(\\d+)\\.(\\d+)\\b",       "replace": "version $1 point $2 point $3" },
    { "pattern": "\\b(\\d+)\\.(\\d+)\\b",                  "replace": "$1 point $2" },
    { "pattern": "\\bASP\\.NET\\b",                        "replace": "A-S-P dot net" },
    { "pattern": "\\.NET\\b",                              "replace": "dot net" },
    { "pattern": "\\bC#",                                  "replace": "C sharp" },
    { "pattern": "\\bF#",                                  "replace": "F sharp" },
    { "pattern": "\\bC\\+\\+",                             "replace": "C plus plus" },
    { "pattern": "PostgreSQL",                             "replace": "Postgresse Q-L" },
    { "pattern": "\\bEF Core\\b",                          "replace": "E-F Core" },
    { "pattern": "\\bAPI\\b",                              "replace": "A-P-I" },
    { "pattern": "\\bMCP\\b",                              "replace": "M-C-P" },
    { "pattern": "\\bLLM\\b",                              "replace": "L-L-M" },
    { "pattern": "\\bRCE\\b",                              "replace": "R-C-E" },
    { "pattern": "\\bSSR\\b",                              "replace": "S-S-R" },
    { "pattern": "\\bSSG\\b",                              "replace": "S-S-G" },
    { "pattern": "\\bUI\\b",                               "replace": "U-I" },
    { "pattern": "\\bUX\\b",                               "replace": "U-X" },
    { "pattern": "\\bSDK\\b",                              "replace": "S-D-K" },
    { "pattern": "\\bCLI\\b",                              "replace": "C-L-I" },
    { "pattern": "\\bIDE\\b",                              "replace": "I-D-E" },
    { "pattern": "\\bSQL\\b",                              "replace": "S-Q-L" },
    { "pattern": "\\bJWT\\b",                              "replace": "J-W-T" },
    { "pattern": "\\bIA\\b",                               "replace": "I-A" },
    { "pattern": "\\bAI\\b",                               "replace": "A-I" },
    { "pattern": "\\bRAG\\b",                              "replace": "R-A-G" },
    { "pattern": "\\bORM\\b",                              "replace": "O-R-M" },
    { "pattern": "\\bDDL\\b",                              "replace": "D-D-L" },
    { "pattern": "\\bAOT\\b",                              "replace": "A-O-T" },
    { "pattern": "\\bJIT\\b",                              "replace": "J-I-T" },
    { "pattern": "\\bLTS\\b",                              "replace": "L-T-S" },
    { "pattern": "\\bSTS\\b",                              "replace": "S-T-S" },
    { "pattern": "\\bEOL\\b",                              "replace": "E-O-L" },
    { "pattern": "\\bGA\\b",                               "replace": "G-A" },
    { "pattern": "\\bRC(\\d+)\\b",                         "replace": "R-C $1" },
    { "pattern": "\\bMoE\\b",                              "replace": "M-o-E" },
    { "pattern": "\\bPII\\b",                              "replace": "P-I-I" },
    { "pattern": "\\bRGPD\\b",                             "replace": "R-G-P-D" },
    { "pattern": "\\bCPU\\b",                              "replace": "C-P-U" },
    { "pattern": "\\bGPU\\b",                              "replace": "G-P-U" },
    { "pattern": "\\bKEV\\b",                              "replace": "K-E-V" },
    { "pattern": "\\bCISA\\b",                             "replace": "C-I-S-A" },
    { "pattern": "\\b(\\d+)B\\b",                          "replace": "$1 B" },
    { "pattern": "\\bkNN\\b",                              "replace": "k-N-N" },
    { "pattern": "\\bHNSW\\b",                             "replace": "H-N-S-W" },
    { "pattern": "\\bONNX\\b",                             "replace": "O-N-N-X" },
    { "pattern": "%",                                       "replace": " pour cent" },
    { "pattern": "\\$",                                     "replace": " dollars" },
    { "pattern": "€",                                       "replace": " euros" }
  ],
  "keepAsIs": ["Angular", "TypeScript", "Symfony", "Kokoro", "Claude", "GitHub", "Postgres"]
}
