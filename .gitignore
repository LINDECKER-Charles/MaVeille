## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/
.idea

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

devops-omnicard

# Config Apache rendue (générée depuis config/*.conf.template)
config/*.conf
config/staging/

# Veille Speaker (speaker/) — audio généré, modèles, venv (jamais versionnés)
speaker/cache/audio/
speaker/cache/index.json
speaker/models/
speaker/.venv/
speaker/**/__pycache__/
speaker/.pytest_cache/

# App Angular (web/) — artefacts de build & données générées
web/node_modules/
web/dist/
web/.angular/
web/coverage/
web/playwright-report/
web/test-results/
web/.lighthouseci/
web/src/app/data/generated/

# Spec fonctionnelle (non versionnée)
FUNCTIONAL_SPEC.md

graphify-out
CLAUDE.md
.claude
design

docs/DEPLOYMENT_SECRETS.md
speaker/vendor/
